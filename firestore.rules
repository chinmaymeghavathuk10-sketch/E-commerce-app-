rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'umapathijbdvt71@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidAddress(addr) {
      return addr is map
        && addr.keys().hasAll(['id', 'label', 'recipient', 'phone', 'line1', 'city', 'state', 'postalCode', 'isDefault'])
        && addr.keys().hasOnly(['id', 'label', 'recipient', 'phone', 'line1', 'line2', 'city', 'state', 'postalCode', 'isDefault'])
        && isValidId(addr.id)
        && isValidString(addr.label, 1, 40)
        && isValidString(addr.recipient, 1, 100)
        && isValidString(addr.phone, 5, 24)
        && isValidString(addr.line1, 3, 160)
        && (!('line2' in addr) || isValidString(addr.line2, 0, 120))
        && isValidString(addr.city, 1, 80)
        && isValidString(addr.state, 1, 80)
        && isValidString(addr.postalCode, 3, 20)
        && addr.isDefault is bool;
    }

    // 3. Entity Validation Blueprints
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().hasOnly(['email', 'createdAt'])
        && isValidString(data.email, 3, 200)
        && data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'phone', 'addresses', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'addresses', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isValidString(data.email, 3, 200)
        && isValidString(data.displayName, 1, 100)
        && isValidString(data.phone, 0, 24)
        && data.addresses is list
        && data.addresses.size() <= 5
        && (data.addresses.size() == 0 || isValidAddress(data.addresses[0]))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'garmentType', 'description', 'price', 'imageUrl', 'sizes', 'colors', 'stock', 'featured', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'category', 'garmentType', 'description', 'price', 'imageUrl', 'sizes', 'colors', 'stock', 'featured', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidString(data.name, 2, 120)
        && data.category in ["Men's Wear", "Women's Wear", "Kids' Wear"]
        && data.garmentType in ['Shirts', 'T-Shirts', 'Jeans', 'Trousers', 'Dresses', 'Jackets']
        && isValidString(data.description, 5, 1200)
        && (data.price is number || data.price is int)
        && data.price > 0
        && data.price <= 100000
        && isValidString(data.imageUrl, 1, 500)
        && data.sizes is list
        && data.sizes.size() >= 1
        && data.sizes.size() <= 10
        && isValidString(data.sizes[0], 1, 20)
        && data.colors is list
        && data.colors.size() >= 1
        && data.colors.size() <= 10
        && isValidString(data.colors[0], 1, 40)
        && data.stock is int
        && data.stock >= 0
        && data.stock <= 100000
        && data.featured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCartItem(item) {
      return item is map
        && item.keys().hasAll(['productId', 'name', 'price', 'imageUrl', 'size', 'color', 'quantity'])
        && item.keys().hasOnly(['productId', 'name', 'price', 'imageUrl', 'size', 'color', 'quantity'])
        && isValidId(item.productId)
        && isValidString(item.name, 1, 120)
        && (item.price is number || item.price is int)
        && item.price > 0
        && isValidString(item.imageUrl, 1, 500)
        && isValidString(item.size, 1, 20)
        && isValidString(item.color, 1, 40)
        && item.quantity is int
        && item.quantity >= 1
        && item.quantity <= 20;
    }

    function isValidCart(data) {
      return data.keys().hasAll(['userId', 'items', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'items', 'updatedAt'])
        && isValidId(data.userId)
        && data.items is list
        && data.items.size() <= 30
        && (data.items.size() == 0 || isValidCartItem(data.items[0]))
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
          'items', 'subtotal', 'shippingFee', 'total', 'shippingAddress',
          'paymentMethod', 'paymentLast4', 'paymentTxnId', 'paymentStatus',
          'status', 'returnStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'orderNumber', 'userId', 'customerName', 'customerEmail',
          'items', 'subtotal', 'shippingFee', 'total', 'shippingAddress',
          'paymentMethod', 'paymentLast4', 'paymentTxnId', 'paymentStatus',
          'status', 'returnStatus', 'returnReason', 'returnRequestedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidString(data.orderNumber, 4, 32)
        && isValidId(data.userId)
        && isValidString(data.customerName, 1, 100)
        && isValidString(data.customerEmail, 3, 200)
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 30
        && isValidCartItem(data.items[0])
        && (data.subtotal is number || data.subtotal is int) && data.subtotal >= 0
        && (data.shippingFee is number || data.shippingFee is int) && data.shippingFee >= 0
        && (data.total is number || data.total is int) && data.total > 0 && data.total >= data.subtotal
        && isValidAddress(data.shippingAddress)
        && data.paymentMethod in ['UPI', 'Debit Card', 'Credit Card', 'Net Banking']
        && isValidString(data.paymentLast4, 1, 48)
        && isValidString(data.paymentTxnId, 6, 64)
        && data.paymentStatus in ['Paid', 'Refunded']
        && data.status in ['Confirmed', 'Packed', 'Shipped', 'Out for Delivery', 'Delivered', 'Cancelled']
        && data.returnStatus in ['None', 'Requested', 'Approved', 'Refunded', 'Rejected']
        && (!('returnReason' in data) || isValidString(data.returnReason, 0, 500))
        && (!('returnRequestedAt' in data) || data.returnRequestedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'verifiedPurchase', 'createdAt'])
        && data.keys().hasOnly(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'verifiedPurchase', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.productId)
        && isValidId(data.userId)
        && isValidString(data.authorName, 1, 80)
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && isValidString(data.comment, 3, 800)
        && data.verifiedPurchase is bool
        && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /test/connection {
      allow get: if true;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(uid) && isValidAdmin(incoming()) && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'addresses', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'updatedAt'])
            && incoming().stock < existing().stock
            && incoming().stock >= 0
          )
        );
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /carts/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCart(incoming())
        && incoming().userId == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidCart(incoming())
        && incoming().userId == existing().userId
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && ((resource != null && existing().userId == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'Confirmed'
        && incoming().paymentStatus == 'Paid'
        && incoming().returnStatus == 'None'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().orderNumber == existing().orderNumber
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            isOwner(existing().userId)
            && existing().status == 'Confirmed'
            && incoming().status == 'Cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            isOwner(existing().userId)
            && existing().status == 'Delivered'
            && existing().returnStatus == 'None'
            && incoming().returnStatus == 'Requested'
            && incoming().returnRequestedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['returnStatus', 'returnReason', 'returnRequestedAt', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;
      allow create: if isVerified()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().id == reviewId
        && incoming().userId == request.auth.uid
        && exists(/databases/$(database)/documents/products/$(incoming().productId))
        && incoming().createdAt == request.time;
      allow update: if isVerified()
        && isValidId(reviewId)
        && isValidReview(incoming())
        && ((resource != null && isOwner(existing().userId)) || isAdmin())
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().productId == existing().productId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'comment']);
      allow delete: if isSignedIn() && isValidId(reviewId) && ((resource != null && isOwner(existing().userId)) || isAdmin());
    }
  }
}
